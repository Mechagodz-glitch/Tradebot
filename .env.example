# Copy to .env. All optional: with none of these set, only the paper venue and public data work.

# Alpaca (US stocks + crypto). Free paper account at https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# ALPACA_PAPER=false     # only when you intend to trade live

# Zerodha Kite Connect (Indian equities). Requires a Kite Connect app (paid subscription).
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=       # regenerate daily: tradebot kite-login

# Any CCXT exchange (crypto). Exchange id is set in config.yaml (ccxt.exchange).
CCXT_API_KEY=
CCXT_SECRET=
CCXT_PASSWORD=           # only some exchanges (OKX, KuCoin) need a passphrase

# Optional bearer token protecting the HTTP API
TRADEBOT_API_TOKEN=

# Optional overrides
# TRADEBOT_CONFIG=config.yaml
# TRADEBOT_DB=data/tradebot.db
# TRADEBOT_LIVE=1
